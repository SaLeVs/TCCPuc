  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshPro
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>M\xC9TRICAS DO JOGO</b>\n<size=70%>Jogador: anda 3 m/s \xB7 corre 6
    m/s \xB7 agachado 1,5 m/s\nStamina: 4 s de corrida \xB7 exausto volta a correr
    em 5,3 s\nCorpo: 1,4 m em p\xE9 \xB7 1,16 m agachado \xB7 degrau m\xE1x. 0,3
    m \xB7 alcance de intera\xE7\xE3o 1 m\nVida: 100 \xB7 lanterna 100 s, alcance
    10 m\nMonstro: patrulha 2 m/s \xB7 investiga 3,5 m/s \xB7 persegue 4 m/s\nSentidos:
    vis\xE3o 40 m / 90\xB0 \xB7 audi\xE7\xE3o 60 m \xB7 segue sem ver por 4 s\nAtaque:
    1 m \xB7 15 de dano \xB7 1 s de recarga \xB7 7 golpes zeram a vida\nPersegui\xE7\xE3o:
    um sprint abre 8 m; andando o monstro tira 1 m/s, alcan\xE7a em 8 s\nBloqueia
    vis\xE3o do monstro: Default, Ground, Interactable, Scenary, DeadPlayer, MainStage,
    Recordable, Walls\nTeto para agachar: Ground, Scenary, Recordable, Walls, Lights,
    Doors, Props\nDegraus sobem em: Ground\nIntera\xE7\xE3o (raio): Interactable,
    Doors</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: c2a1b3d52c3f9cf49bc8eb107a5bc4c3, type: 2}
  m_sharedMaterial: {fileID: 8979655907117184334, guid: c2a1b3d52c3f9cf49bc8eb107a5bc4c3, type: 2}

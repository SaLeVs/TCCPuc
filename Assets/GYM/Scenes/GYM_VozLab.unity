--- !u!114 &1057427829
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1057427827}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 48d783100a6a6dd40b48bd40271c6923, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LevelDesign.Gym.VoiceLab.GymVoiceLab
  speaker: {fileID: 1567227062}
  speakerBody: {fileID: 1567227063}
  scenarios:
  - name: "Mesma sala \u2192 porta \u2192 corredor"
    hint: "Saia pela porta ao norte e siga o corredor: repare no degrau de volume
      quando a parede entra entre voc\xEAs."
    playerPoint: {fileID: 715529045}
    speakerPoint: {fileID: 901364029}
    facing: 0
  - name: "Corredor reto (vis\xE3o livre)"
    hint: "Ande para o norte pelo corredor olhando a dist\xE2ncia: aqui s\xF3 a curva
      e a borda do alcance agem."
    playerPoint: {fileID: 390310478}
    speakerPoint: {fileID: 2044669789}
    facing: 0
  - name: Virando o corredor
    hint: "Siga at\xE9 a curva (z \u2248 44) e vire para o leste: a parede corta
      a linha de vis\xE3o."
    playerPoint: {fileID: 1260585251}
    speakerPoint: {fileID: 1484324636}
    facing: 0
  - name: "Sala vizinha (atrav\xE9s da parede)"
    hint: Salas vizinhas. Abra e feche as portas entre elas (O perto da porta) e
      compare.
    playerPoint: {fileID: 1449341684}
    speakerPoint: {fileID: 1046086941}
    facing: 0
  - name: "Audit\xF3rio (palco \u2192 plateia)"
    hint: Companheiro no palco, dentro da zona com reverb. Suba pela plateia e saia

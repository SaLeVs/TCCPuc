  m_Script: {fileID: 11500000, guid: 4ec5ba79c34a9774ca66ad4d91754c42, type: 3}
  m_Name: LevelToolkitCatalog
  m_EditorClassIdentifier: Assembly-CSharp-Editor::LevelDesign.Toolkit.LevelToolkitCatalog
  metricsSnapshot: "Jogador: anda 3 m/s \xB7 corre 6 m/s \xB7 agachado 1,5 m/s\nStamina:
    4 s de corrida \xB7 exausto volta a correr em 5,3 s\nCorpo: 1,4 m em p\xE9 \xB7
    1,16 m agachado \xB7 degrau m\xE1x. 0,3 m \xB7 alcance de intera\xE7\xE3o 1 m\nVida:
    100 \xB7 lanterna 100 s, alcance 10 m\nMonstro: patrulha 2 m/s \xB7 investiga
    3,5 m/s \xB7 persegue 4 m/s\nSentidos: vis\xE3o 40 m / 90\xB0 \xB7 audi\xE7\xE3o
    60 m \xB7 segue sem ver por 4 s\nAtaque: 1 m \xB7 15 de dano \xB7 1 s de recarga
    \xB7 7 golpes zeram a vida\nPersegui\xE7\xE3o: um sprint abre 8 m; andando o
    monstro tira 1 m/s, alcan\xE7a em 8 s\nBloqueia vis\xE3o do monstro: Default,
    Ground, Interactable, Scenary, DeadPlayer, MainStage, Recordable, Walls\nTeto
    para agachar: Ground, Scenary, Recordable, Walls, Lights, Doors, Props\nDegraus
    sobem em: Ground\nIntera\xE7\xE3o (raio): Interactable, Doors"
  lastScan: 2026-10-16 21:17
